# Copy to .env.local and fill in. Never commit a filled-in copy.
# Both are read only in route handlers and scripts — never in a client component.

# GitHub API token for repository ingest (public repo read scope is enough).
GITHUB_TOKEN=

# Anthropic API key for pull-request enrichment.
ANTHROPIC_API_KEY=

# Optional, and not credentials. They bound what one live analysis may fetch, and are read
# in the analysis route before any request is made. Leave blank to take the default; a
# value that is present but unusable makes the route fail rather than silently defaulting.

# How far back a live analysis looks, in whole days. 1-365. Default 90.
GRAIN_ANALYSIS_WINDOW_DAYS=

# Ceiling on pull requests analyzed, applied before fetching starts. 1-500. Default 100.
GRAIN_MAX_PULL_REQUESTS=

# The model on-demand enrichment and the bake command use. Default claude-haiku-4-5.
ENRICHMENT_MODEL=
